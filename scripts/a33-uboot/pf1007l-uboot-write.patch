diff --git a/arch/arm/dts/sun8i-a33-pf1007l-write.dts b/arch/arm/dts/sun8i-a33-pf1007l-write.dts
new file mode 100644
index 00000000..1a2b3c4d
--- /dev/null
+++ b/arch/arm/dts/sun8i-a33-pf1007l-write.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * PF1007L/ZC002 writable build: identical hardware setup to the repo's
+ * read-only pf1007l-backup build (Q8 A33 tablet reference design), but
+ * WITHOUT the cmd/usb_mass_storage.c and f_mass_storage.c write-blocking
+ * patches. This U-Boot's `ums` exposes attached storage as a NORMAL,
+ * WRITABLE USB disk. Use only with a guarded, verified writer script,
+ * never to format or carelessly mount.
+ * - eMMC on MMC2, 8-bit (as the boot-access notes observed on this PCB)
+ * - USB OTG forced to peripheral so the computer stays the host
+ * - no VBUS drive: the frame is powered from the host's VBUS
+ */
+
+#include "sun8i-a33-q8-tablet.dts"
+
+/ {
+	model = "PF1007L/ZC002 write (Q8 A33 base)";
+};
+
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc2_8bit_pins>;
+	vmmc-supply = <&reg_dcdc1>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+
+&usb_otg {
+	dr_mode = "peripheral";
+};
+
+&usbphy {
+	/delete-property/ usb0_vbus-supply;
+	/delete-property/ usb0_id_det-gpios;
+};
diff --git a/configs/pf1007l_write_defconfig b/configs/pf1007l_write_defconfig
new file mode 100644
index 00000000..5e6f7a8b
--- /dev/null
+++ b/configs/pf1007l_write_defconfig
@@ -0,0 +1,15 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="sun8i-a33-pf1007l-write"
+CONFIG_SPL=y
+CONFIG_MACH_SUN8I_A33=y
+CONFIG_DRAM_CLK=456
+CONFIG_DRAM_ZQ=15291
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+# CONFIG_VIDEO_SUNXI is not set
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_CONS_INDEX=5
+CONFIG_BOOTDELAY=-2
+CONFIG_USB_MUSB_GADGET=y
+CONFIG_CMD_USB_MASS_STORAGE=y
+CONFIG_CRC32_VERIFY=y
